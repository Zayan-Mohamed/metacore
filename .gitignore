# Python
__pycache__/
*.py[cod]
.venv/
venv/
.eggs/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
uv.lock.local

# Go
bin/
*.test
*.out

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Data blobs (tracked by DVC, not git)
data/raw/**
data/processed/**
data/external/**
!data/**/.gitkeep
!data/**/README.md
# The published calibration artifacts are git-tracked; data/.gitignore names them individually.
!data/processed/*.csv
!data/processed/*.json
!data/raw/nasa_power/*.csv
!data/raw/nasa_power/*.json
*.dvc.lock

# Models & artefacts
*.pt
*.pth
*.onnx
*.ckpt
# Contents, not the directory, so a single file can be re-included below.
**/artifacts/*
mlruns/
wandb/

# OpenDSS run output
*.DSS_out
*.csv.gz
deterministic-core/**/output/

# Env & secrets
.env
.env.*
!.env.example
infra/env/*.env
!infra/env/*.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Notebooks
.ipynb_checkpoints/

# Synthetic stand-in inputs (task data:synthetic). Never the real artifacts.
/.synthetic/

# Forecast test predictions are regenerated by module1.train.run (several MB each)
reports/**/test_predictions_*.npz

# The trained ST-GNN v0.1 (equal weighting), 92 KB: lets /module1/forecast and the dashboard
# page work from a clean clone, and un-skips the gateway forecast tests in CI (PR #12 review).
!services/learned/module1_state_forecasting/artifacts/stgnn_v0_1_equal.pt
# ADR 0006: the Open-Meteo-trained model the live worker serves.
!services/learned/module1_state_forecasting/artifacts/stgnn_v0_1_om_equal.pt
# ...and the fair baseline it is compared with live (22 KB).
!services/learned/module1_state_forecasting/artifacts/lstm_1d_residual_v0_1_om_equal.pt

# M4's frozen calibration (bands, miss rows, input hashes), ~650 KB. The verifier reads it on
# every call and `python -m verification.calibrate check` asserts it rebuilds byte-identically.
!deterministic-core/module4_verification/src/verification/artifacts/calibration_v1.json

# Playwright run output (apps/dashboard: pnpm test:e2e)
apps/dashboard/test-results/
apps/dashboard/playwright-report/
